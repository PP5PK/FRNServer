[Manager1]
# http://alterfrn.ucoz.ru/index/server_config/0-27#s_2
ManagerEnabled=yes
ManagerAddress=sysman.lpd-net.ru
ManagerPort=10025
ManagerAuthEMail=svrutz@gmail.com
ManagerAuthPassword=DIPOJEXI
ManagerConnectTimeout=3
ManagerActivityTimeout=8
ManagerReconnectInterval=60
ManagerLogErrors=yes
ManagerLogDebug=0
ManagerPreferIPv4=yes

[System]
# http://alterfrn.ucoz.ru/index/server_config/0-27#s_3
PidFile=frnserver.pid
LogFile=/var/log/frnserver.log
LogClientLevel=5
LogExec=yes
ListDelimiter=";"
# DataChangeScript=
DataDir=/usr/src/FRNServer/
SystemCharsetName=ISO-8859-1

[Command]
# http://alterfrn.ucoz.ru/index/server_config/0-27#s_6
CommandEnabled=yes
CommandPort=10023
CommandIPVersion=46
CommandPreferIPv4=yes

#[Recorder]
#Enabled=yes
#Dir=/home/whrebe/FRNrecorder
#Direction=B
#FileNameFormat=S
#SubdirMode=YMD
#MaxRecordTime=360
